    "demo:readiness:build": "node scripts/build-readiness-map.cjs",
    "test:readiness": "node --test test/readiness-map.test.cjs test/readiness-sync.test.cjs",
    "test:trace-gate": "node --test test/trace-gate-thresholds.test.cjs test/trace-gate-decision-logic.test.cjs test/trace-artifact-naming.test.cjs test/live-verification-matrix-index.test.cjs",
    "guard:epic-ids": "node scripts/epic-id-guard.cjs",
