    "test:test-design-routing": "node --test test/test-design-workflow-routing.test.cjs",
    "test:test-design-lifecycle": "node --test test/test-design-lifecycle-state.test.cjs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "sync:clickup": "node scripts/sync-clickup.cjs",
    "create:clickup": "node scripts/create-clickup-task.cjs",
    "test:clickup": "node --test test/clickup-lib.test.cjs test/clickup-sync.test.cjs test/clickup-create.test.cjs test/clickup-safety.test.cjs test/clickup-descriptions.test.cjs",
    "debug:clickup-lookup": "node scripts/debug-clickup-lookup.cjs",
    "preflight:clickup": "node scripts/preflight-clickup-live.cjs",
